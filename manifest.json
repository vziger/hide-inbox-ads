{
	"name": "Hide mail.ru inbox ads",
	"description": "Скрывает рекламу в e.mail.ru, Яндекс.Переводчике, Яндекс.Погоде",
	"version": "1.1",
	"manifest_version": 3,
	"icons": {
		"16": "icons/icon16.png",
		"32": "icons/icon32.png",
		"48": "icons/icon48.png",
		"128": "icons/icon128.png"
	},
	"action": {
		"default_popup": "popup.html",
		"default_icon": {
			"16": "icons/icon16.png",
			"32": "icons/icon32.png",
			"48": "icons/icon48.png",
			"128": "icons/icon128.png"
		}
	},
	"permissions": ["storage", "activeTab", "declarativeNetRequest"],
	"host_permissions": ["*://yandex.ru/*", "*://*.yandex.ru/*", "*://*.naydex.net/*"],
	"content_scripts": [
		{
			"matches": ["https://e.mail.ru/*"],
			"js": ["content.js"],
			"css": ["hide.css"],
			"run_at": "document_start",
			"all_frames": true
		},
		{
			"matches": ["https://translate.yandex.ru/*"],
			"js": ["yandex.js"],
			"css": ["hide.css"],
			"run_at": "document_start",
			"all_frames": false
		},
		{
			"matches": ["https://yandex.ru/pogoda/*"],
			"js": ["pogoda.js"],
			"css": ["hide.css"],
			"run_at": "document_start",
			"all_frames": false
		}
	],
	"declarative_net_request": {
		"rule_resources": [
			{
				"id": "yandex_ntp",
				"enabled": true,
				"path": "rules.json"
			}
		]
	}
}
