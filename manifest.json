{
	"name": "Hide mail.ru inbox ads",
	"description": "Скрывает рекламный блок в правой колонке e.mail.ru",
	"version": "1.0",
	"manifest_version": 3,
	"icons": {
		"16": "icons/icon16.png",
		"32": "icons/icon32.png",
		"48": "icons/icon48.png",
		"128": "icons/icon128.png"
	},
	"action": {
		"default_popup": "popup.html",
		"default_icon": {
			"16": "icons/icon16.png",
			"32": "icons/icon32.png",
			"48": "icons/icon48.png",
			"128": "icons/icon128.png"
		}
	},
	"permissions": ["storage", "activeTab"],
	"content_scripts": [
		{
			"matches": ["https://e.mail.ru/*"],
			"js": ["content.js"],
			"css": ["hide.css"],
			"run_at": "document_start",
			"all_frames": true
		}
	]
}
